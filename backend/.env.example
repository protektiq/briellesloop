PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_MS=10000

# Kokoro TTS:
# - Omit or "false": model loads on first GET /api/tts (recommended for dev).
# - "true": warm model before listen (faster first HTTP TTS; first load may still print harmless
#   TimeoutOverflowWarning lines from @huggingface/transformers once per process).
# KOKORO_EAGER_INIT=false
